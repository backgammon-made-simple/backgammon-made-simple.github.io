.bms-hero {
  display: grid;
  gap: 2rem;
  min-height: 58vh;
  padding: clamp(2.5rem, 6vw, 5rem) 0;
}

.bms-hero h1 {
  font-size: clamp(2.25rem, 5vw, 4.4rem);
  line-height: 1.05;
  margin-bottom: 1rem;
  max-width: 900px;
}

.bms-hero p {
  color: var(--bms-text-secondary);
  font-size: clamp(1.05rem, 1.8vw, 1.3rem);
  max-width: 760px;
}

.bms-grid {
  display: grid;
  gap: 1rem;
}

.bms-grid-four {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.bms-card {
  background: var(--bms-surface);
  border: 1px solid var(--bms-border);
  border-radius: 8px;
  box-shadow: var(--bms-shadow-soft);
  color: var(--bms-text);
  padding: 1.1rem;
}

.bms-card h2,
.bms-card h3 {
  font-size: 1.15rem;
  margin-top: 0;
}

.bms-card p:last-child {
  margin-bottom: 0;
}

.bms-bot-banner {
  background: var(--bms-ivory);
  border: 1px solid var(--bms-border);
  border-radius: 8px;
  color: var(--bms-copper-dark);
  font-size: 0.95rem;
  margin: 1rem 0 0;
  padding: 0.65rem 0.9rem;
}

.bms-bot-banner a {
  color: var(--bms-copper-dark);
  font-weight: 800;
}

.bms-analyzer-form {
  display: grid;
  gap: 0.65rem;
}

.bms-analyzer-form label {
  color: var(--bms-navy);
  font-weight: 800;
}

.bms-analyzer-form-row {
  display: flex;
  gap: 0.5rem;
}

.bms-analyzer-form input {
  background: var(--bms-surface);
  border: 1px solid var(--bms-border-strong);
  border-radius: 6px;
  color: var(--bms-text);
  flex: 1;
  min-height: 42px;
  min-width: 0;
  padding: 0.55rem 0.65rem;
}

.bms-analyzer-form input:focus {
  border-color: var(--bms-focus);
  box-shadow: 0 0 0 0.2rem rgba(0, 114, 178, 0.18);
  outline: 0;
}

.bms-analyzer-form button {
  background: var(--bms-navy-dark);
  border: 0;
  border-radius: 6px;
  color: #fff;
  font-weight: 800;
  min-height: 42px;
  padding: 0.55rem 0.8rem;
}

.bms-analyzer-form button:hover,
.bms-analyzer-form button:focus {
  background: var(--bms-navy);
}

.bms-right-rail-card,
.bms-lesson-meta {
  background: var(--bms-surface);
  border: 1px solid var(--bms-border);
  border-radius: 8px;
  padding: 1rem;
}

.bms-right-rail-card {
  box-shadow: var(--bms-shadow-soft);
}

.bms-lesson-meta {
  color: var(--bms-text-secondary);
  font-size: 0.95rem;
}

.bms-decision-prompt {
  background: #F8F0E8;
  border: 1px solid var(--bms-border);
  border-radius: 8px;
  margin: 1rem 0;
  padding: 1rem;
}

.bms-report-problem {
  border-top: 1px solid var(--bms-border);
  color: var(--bms-text-muted);
  font-size: 0.95rem;
  margin-top: 2rem;
  padding-top: 1rem;
}

.bms-button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1.25rem;
}

.bms-button,
.bms-button-primary,
.bms-button-secondary,
.bms-button-outline {
  align-items: center;
  border-radius: 6px;
  display: inline-flex;
  font-weight: 700;
  justify-content: center;
  min-height: 44px;
  padding: 0.7rem 1rem;
  text-decoration: none;
}

.bms-button-primary {
  background: var(--bms-navy-dark);
  border: 1px solid var(--bms-navy-dark);
  color: #fff;
}

.bms-button-secondary {
  background: var(--bms-copper-dark);
  border: 1px solid var(--bms-copper-dark);
  color: #fff;
}

.bms-button-outline {
  background: transparent;
  border: 1px solid var(--bms-copper-dark);
  color: var(--bms-copper-dark);
}

.bms-button-primary:hover,
.bms-button-secondary:hover {
  color: #fff;
  filter: brightness(0.94);
}

.bms-callout {
  background: #F8F0E8;
  border: 1px solid var(--bms-border);
  border-left: 4px solid var(--bms-copper);
  border-radius: 8px;
  margin: 1.4rem 0;
  padding: 1rem 1.1rem;
}

.bms-callout-title {
  color: var(--bms-navy);
  font-weight: 800;
  margin-bottom: 0.25rem;
}

.bms-badge {
  border-radius: 999px;
  display: inline-flex;
  font-size: 0.78rem;
  font-weight: 700;
  line-height: 1;
  padding: 0.42rem 0.62rem;
}

.bms-badge-beginner {
  background: rgba(47, 107, 79, 0.14);
  color: var(--bms-success);
}

.bms-badge-intermediate {
  background: rgba(167, 97, 27, 0.14);
  color: var(--bms-warning);
}

.bms-badge-advanced {
  background: rgba(146, 59, 69, 0.14);
  color: var(--bms-danger);
}

.bms-badge-cube {
  background: rgba(172, 118, 82, 0.18);
  color: var(--bms-copper-dark);
}

.bms-status {
  align-items: center;
  border: 1px solid;
  border-radius: 999px;
  display: inline-flex;
  font-weight: 700;
  gap: 0.35rem;
  line-height: 1.2;
  padding: 0.28rem 0.68rem;
}

.bms-status--info {
  background: #EAF4FA;
  border-color: #0072B2;
  color: #005680;
}

.bms-status--neutral {
  background: #ECEEF0;
  border-color: #8A8F98;
  color: #4F5560;
}

.bms-status--warning {
  background: #FFF1CC;
  border-color: #E69F00;
  color: #805900;
}

.bms-analysis-shell {
  display: grid;
  gap: 1rem;
  grid-template-columns: minmax(280px, 420px) minmax(0, 1fr);
  margin-top: 1.25rem;
}

.bms-result-grid {
  display: grid;
  gap: 0.85rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.bms-result-slot {
  background: var(--bms-page-background);
  border: 1px solid var(--bms-border);
  border-radius: 8px;
  padding: 0.85rem;
}

.bms-result-slot h3 {
  font-size: 1rem;
  margin: 0 0 0.35rem;
}

.bms-identifier {
  color: var(--bms-text-secondary);
  font-family: "Source Code Pro", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.86rem;
  overflow-wrap: anywhere;
}

.bms-status--mistake {
  background: #FBE5DD;
  border-color: #D55E00;
  color: #8A3900;
}

.bms-subscribe {
  align-items: center;
  background: var(--bms-navy);
  border-radius: 8px;
  color: #fff;
  display: grid;
  gap: 1rem;
  grid-template-columns: 1fr minmax(260px, 420px);
  margin: 2rem 0;
  padding: 1.25rem;
}

.bms-subscribe h2,
.bms-subscribe p {
  color: #fff;
  margin: 0;
}

.bms-placeholder-board {
  background: linear-gradient(135deg, var(--bms-ivory), var(--bms-surface));
  border: 1px dashed var(--bms-border);
  border-radius: 8px;
  color: var(--bms-text-muted);
  display: grid;
  min-height: 220px;
  place-items: center;
  text-align: center;
}

.page-footer,
.nav-footer {
  background: var(--bms-surface);
  border-top: 1px solid var(--bms-border);
  color: var(--bms-text-secondary);
  font-size: 0.82rem;
  line-height: 1.45;
}

.nav-footer-left {
  color: var(--bms-navy);
  font-weight: 700;
}

.nav-footer-center {
  max-width: 760px;
}

@media (max-width: 980px) {
  .bms-grid-four {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .bms-subscribe {
    grid-template-columns: 1fr;
  }

  .bms-analysis-shell {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .bms-grid-four {
    grid-template-columns: 1fr;
  }

  .bms-button-row,
  .bms-button,
  .bms-button-primary,
  .bms-button-secondary,
  .bms-button-outline {
    width: 100%;
  }

  .bms-analyzer-form-row {
    flex-direction: column;
  }

  .bms-analyzer-form button {
    width: 100%;
  }

  .bms-result-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   Reusable editorial and tool components

   These classes are intentionally page-neutral. Use them on Analyze,
   Research, Sage vs GNU, Match Predictor, lessons, and future tool pages.
   ========================================================= */

.bms-status-panel,
.bms-analyze-status {
  margin: 1.75rem 0 2rem;
  padding: 1rem 1.1rem;
  border: 1px solid var(--bms-border);
  border-left: 3px solid var(--bms-copper);
  border-radius: 6px;
  background: color-mix(in srgb, var(--bms-ivory) 72%, var(--bms-surface));
}

.bms-status-panel p,
.bms-analyze-status p {
  margin: 0.35rem 0 0;
}

.bms-status-panel > :last-child,
.bms-analyze-status > :last-child {
  margin-bottom: 0;
}

.bms-status-label,
.bms-status-panel .bms-technical-label,
.bms-analyze-status .bms-technical-label {
  display: block;
  color: var(--bms-copper-dark);
  font-family: "Source Code Pro", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.72rem;
  font-weight: 650;
  letter-spacing: 0.055em;
  line-height: 1.35;
  text-transform: uppercase;
}

.bms-step-row,
.bms-analyze-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 2rem 0 0;
  border-top: 1px solid var(--bms-border);
  border-bottom: 1px solid var(--bms-border);
}

.bms-step,
.bms-analyze-step {
  min-width: 0;
  padding: 1.15rem 1.1rem 1.2rem;
}

.bms-step + .bms-step,
.bms-analyze-step + .bms-analyze-step {
  border-left: 1px solid var(--bms-border);
}

.bms-step p,
.bms-analyze-step p {
  margin: 0.35rem 0 0;
  color: var(--bms-text-secondary);
  font-size: 0.94rem;
  line-height: 1.52;
}

.bms-step-number,
.bms-analyze-step-number {
  display: block;
  margin-bottom: 0.45rem;
  color: var(--bms-copper-dark);
  font-family: "Source Code Pro", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.75rem;
  font-weight: 650;
  letter-spacing: 0.06em;
}

.bms-tool-area,
.bms-analyze-tool {
  width: 100%;
  margin: 2.25rem auto 3.5rem;
}

.bms-tool-frame,
.bms-analyzer-frame {
  width: min(100%, var(--bms-editorial-reading-width, 820px));
  margin-right: auto;
  margin-left: auto;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.bms-tool-frame iframe,
.bms-analyzer-frame iframe {
  display: block;
  width: 100%;
  height: 760px;
  overflow: hidden;
  border: 0;
  background: transparent;
}

.bms-external-link,
.bms-analyzer-fallback {
  width: min(100%, var(--bms-editorial-reading-width, 820px));
  margin: 0.75rem auto 0;
  color: var(--bms-text-muted);
  font-size: 0.93rem;
  text-align: right;
}

.bms-external-link p,
.bms-analyzer-fallback p {
  margin: 0;
}

.bms-external-link a,
.bms-analyzer-fallback a {
  font-weight: 700;
  text-decoration: none;
}

.bms-inline-note,
.bms-analyze-note {
  margin: 2rem 0 0;
  padding: 1rem 1.1rem;
  border-top: 1px solid var(--bms-border);
  border-bottom: 1px solid var(--bms-border);
  color: var(--bms-text-secondary);
}

.bms-inline-note .bms-technical-label,
.bms-analyze-note .bms-technical-label {
  display: block;
  margin-bottom: 0.35rem;
  color: var(--bms-copper-dark);
  font-size: 0.72rem;
  font-weight: 650;
  letter-spacing: 0.055em;
}

.bms-inline-note p,
.bms-analyze-note p {
  margin: 0;
}

@media (max-width: 900px) {
  .bms-step-row,
  .bms-analyze-steps {
    grid-template-columns: 1fr;
  }

  .bms-step + .bms-step,
  .bms-analyze-step + .bms-analyze-step {
    border-top: 1px solid var(--bms-border);
    border-left: 0;
  }

  .bms-tool-frame iframe,
  .bms-analyzer-frame iframe {
    height: 780px;
  }
}

@media (max-width: 640px) {
  .bms-tool-area,
  .bms-analyze-tool {
    margin-top: 2rem;
  }

  .bms-tool-frame,
  .bms-analyzer-frame {
    width: 100%;
  }

  .bms-tool-frame iframe,
  .bms-analyzer-frame iframe {
    height: 820px;
  }

  .bms-external-link,
  .bms-analyzer-fallback {
    text-align: left;
  }
}

/* =========================================================
   Reusable research-report and release components

   These remain page-neutral so they can be reused by benchmark reports,
   Research posts, data releases, and methodology pages.
   ========================================================= */

.bms-figure-slot {
  display: grid;
  align-content: center;
  min-height: 150px;
  margin: 1.4rem 0 2.25rem;
  padding: 1.3rem 0;
  border-top: 1px solid var(--bms-border);
  border-bottom: 1px solid var(--bms-border);
  color: var(--bms-text-secondary);
}

.bms-figure-slot p {
  margin: 0.45rem 0 0;
}

.bms-figure-slot-label,
.bms-release-state {
  display: block;
  margin-bottom: 0.5rem;
  color: var(--bms-copper-dark);
  font-family: "Source Code Pro", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.72rem;
  font-weight: 650;
  letter-spacing: 0.055em;
  line-height: 1.35;
  text-transform: uppercase;
}

.bms-release-list {
  margin: 1.5rem 0 2.25rem;
  border-top: 1px solid var(--bms-border);
}

.bms-release-item {
  padding: 1.35rem 0 1.5rem;
  border-bottom: 1px solid var(--bms-border);
}

.bms-release-item h3 {
  margin: 0 0 0.4rem;
  color: var(--bms-navy-dark);
  font-size: 1.28rem;
  line-height: 1.25;
}

.bms-release-meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.9rem 1.5rem;
  margin-top: 1rem;
  color: var(--bms-text-secondary);
  font-size: 0.94rem;
}

.bms-release-meta p {
  min-width: 0;
  margin: 0;
}

.bms-release-meta code {
  overflow-wrap: anywhere;
}

@media (max-width: 700px) {
  .bms-release-meta {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   Reusable landing-page components

   Append this block to site/assets/bms-components.css.
   It uses the existing BMS hero, card, button, callout, and grid components.
   ========================================================= */

body.bms-landing-page #title-block-header {
  display: none;
}

body.bms-landing-page main#quarto-document-content {
  width: 100%;
  max-width: none;
  padding-top: 0;
}

body.bms-landing-page .page-columns {
  display: block;
}

.bms-landing {
  box-sizing: border-box;
  width: min(calc(100% - 3rem), 1180px);
  margin-inline: auto;
  padding-bottom: clamp(4rem, 8vw, 7rem);
}

.bms-eyebrow {
  color: var(--bms-copper-dark);
  font-family: "Source Code Pro", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.76rem;
  font-weight: 650;
  letter-spacing: 0.075em;
  line-height: 1.35;
  text-transform: uppercase;
}

.bms-eyebrow p,
.bms-hero-copy p,
.bms-section-lead p,
.bms-section-closing p {
  margin: 0;
}

.bms-landing .bms-hero {
  display: flex;
  min-height: min(680px, 72vh);
  flex-direction: column;
  justify-content: center;
  gap: 0;
}

.bms-landing .bms-hero h1 {
  margin-top: 0.85rem;
  font-size: clamp(2.75rem, 6.5vw, 5.6rem);
  font-weight: 760;
  letter-spacing: -0.045em;
  line-height: 0.98;
}

.bms-hero-copy {
  max-width: 760px;
  color: var(--bms-text-secondary);
  font-size: clamp(1.16rem, 2vw, 1.42rem);
  font-weight: 500;
  line-height: 1.55;
}

.bms-section {
  margin-top: clamp(4rem, 8vw, 7rem);
}

.bms-section > h2,
.bms-section > .bms-callout > h2 {
  max-width: 800px;
  margin-bottom: 1.15rem;
  color: var(--bms-navy-dark);
  font-size: clamp(2rem, 3.8vw, 3.25rem);
  font-weight: 730;
  letter-spacing: -0.035em;
  line-height: 1.08;
}

.bms-section-lead {
  max-width: 760px;
  color: var(--bms-text-secondary);
  font-size: clamp(1.08rem, 1.7vw, 1.25rem);
  line-height: 1.6;
}

.bms-section--ruled {
  padding: clamp(2.4rem, 5vw, 4rem) 0;
  border-top: 1px solid var(--bms-border);
  border-bottom: 1px solid var(--bms-border);
}

.bms-card-stack {
  display: flex;
  min-height: 100%;
  flex-direction: column;
  padding: clamp(1.35rem, 2.5vw, 1.8rem);
}

.bms-card-stack h3 {
  margin: 0.65rem 0 0.6rem;
  font-size: clamp(1.35rem, 2vw, 1.65rem);
  font-weight: 720;
  letter-spacing: -0.02em;
  line-height: 1.15;
}

.bms-card-stack > p {
  color: var(--bms-text-secondary);
  line-height: 1.58;
}

.bms-card-stack > .bms-button-row:last-child {
  margin-top: auto;
  padding-top: 1rem;
}

.bms-process-label {
  margin-top: 2.5rem;
}

.bms-process {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  margin-top: 0.75rem;
  border-top: 1px solid var(--bms-border);
  border-bottom: 1px solid var(--bms-border);
}

.bms-process-step {
  position: relative;
  min-width: 0;
  padding: 1.25rem 1.15rem 1.35rem;
}

.bms-process-step + .bms-process-step {
  border-left: 1px solid var(--bms-border);
}

.bms-process-step:not(:last-child)::after {
  content: "→";
  position: absolute;
  z-index: 1;
  top: 50%;
  right: -0.48rem;
  width: 0.95rem;
  transform: translateY(-50%);
  background: var(--bms-page-background);
  color: var(--bms-copper-dark);
  font-weight: 800;
  line-height: 1;
  text-align: center;
}

.bms-process-number {
  display: block;
  margin-bottom: 0.55rem;
  color: var(--bms-copper-dark);
  font-family: "Source Code Pro", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.72rem;
  font-weight: 650;
  letter-spacing: 0.06em;
}

.bms-process-step strong {
  display: block;
  color: var(--bms-navy);
  font-size: 1rem;
  line-height: 1.4;
}

.bms-section-closing {
  max-width: 760px;
  margin-top: 1.45rem;
  color: var(--bms-navy);
  font-size: 1.12rem;
  font-weight: 650;
  line-height: 1.55;
}

[data-bs-theme="dark"] .bms-landing .bms-hero h1,
[data-bs-theme="dark"] .bms-section > h2,
[data-bs-theme="dark"] .bms-section > .bms-callout > h2,
[data-bs-theme="dark"] .bms-card-stack h3,
[data-bs-theme="dark"] .bms-process-step strong,
[data-bs-theme="dark"] .bms-section-closing {
  color: var(--bms-text);
}

@media (max-width: 980px) {
  .bms-process {
    grid-template-columns: 1fr;
  }

  .bms-process-step + .bms-process-step {
    border-top: 1px solid var(--bms-border);
    border-left: 0;
  }

  .bms-process-step:not(:last-child)::after {
    content: "↓";
    top: auto;
    right: 50%;
    bottom: -0.52rem;
    width: 1.05rem;
    transform: translateX(50%);
  }
}

@media (max-width: 720px) {
  .bms-landing {
    width: min(calc(100% - 2rem), 1180px);
  }

  .bms-landing .bms-hero {
    min-height: auto;
    padding-top: 4rem;
  }
}
